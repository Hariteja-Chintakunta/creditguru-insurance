# CreditGuru Insurance — environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# No real values are stored in this repo.

# Supabase project (create at https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend (optional) — when set, emails are sent via Resend;
# when absent, emails are recorded in the email_logs table instead.
RESEND_API_KEY=

# Public site URL shown in links (referral links, email links)
NEXT_PUBLIC_SITE_URL=https://creditguruinsurances.com
